# FinSpark backend environment — copy to .env and fill in. NEVER commit .env.
# Database
# Running the backend on the HOST (npm run start:dev, prisma migrate): use localhost:5433
#   (host 5432 is often taken by a local Postgres service; compose maps container -> host 5433)
# Running the backend INSIDE docker compose: use the service host `postgres:5432`
DATABASE_URL=postgresql://finspark:<pass>@localhost:5433/finspark

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m

# SMTP (Zoho — use an app-specific password, not the mailbox password)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_USER_TO=

# OTP / lockout policy
OTP_TTL_SECONDS=100
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5

# App
PORT=3001

# Sentinel Fusion AI model service (Phase 2). SENTINEL_ENABLED=false keeps the
# Phase 1 heuristic scorer; true routes /score through the model and fails open
# to the heuristic on error/timeout.
#   Backend in Docker  -> http://host.docker.internal:8000 (needs extra_hosts, see compose)
#   Backend on host    -> http://127.0.0.1:8000  (use 127.0.0.1, NOT localhost —
#                         Node may resolve localhost to IPv6 ::1 and time out)
SENTINEL_ENABLED=false
SENTINEL_URL=http://host.docker.internal:8000
SENTINEL_API_KEY=sentinel-demo-key-2026
SENTINEL_TIMEOUT_MS=800

# DEV ONLY. Loopback (browser->localhost) hides your VPN from req.ip. When true,
# a private/loopback IP falls back to geolocating your PUBLIC egress IP so local
# testing reflects your real / VPN country. NEVER enable in production (there the
# real client IP arrives via X-Forwarded-For).
GEO_DEV_USE_PUBLIC_IP=false

# DEV ONLY. Honour the login page's mock-VPN country selector (X-Mock-Country
# header) as the client country, overriding geo-IP. NEVER enable in production —
# trusting a client-supplied country lets attackers spoof location.
GEO_ALLOW_MOCK_COUNTRY=false

# DEMO ONLY. Mounts /api/demo-tests/*, which spawns Playwright on request to
# drive the test panel on the login page. Those routes are UNAUTHENTICATED (the
# panel is pre-auth and EventSource cannot send headers); the protection is this
# flag plus a fixed spec allowlist plus argv-array exec. Never enable outside a
# demo machine.
DEMO_TEST_RUNNER=false

# ---------------------------------------------------------------------------
# IMPORTANT: this file is documentation, not configuration.
#
# The backend has NO dotenv loader — no ConfigModule, no `dotenv` import;
# src/common/env.ts reads process.env directly. A value written here does not
# reliably reach the code that picks the scorer. EXPORT these into the process:
#
#   eval "$(npm run --silent e2e:env)" && npm run dev:backend:demo
#
# `npm run e2e:env` prints the full demo export block with explanations.
# ---------------------------------------------------------------------------
